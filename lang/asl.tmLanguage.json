{
  "name": "ACPI Source Language(ASL)",
  "scopeName": "source.uefi-asl",
  "fileTypes": [
    "asl",
    "asi"
  ],
  "patterns": [
    {
      "include": "#comment"
    },
    {
      "include": "#comment_block"
    }
  ],
  "repository": {
    "comment": {
      "match": "//.*$",
      "name": "comment.line.double-slash.uefi-asl"
    },
    "comment_block": {
      "begin": "/\\*",
      "end": "\\*/",
      "name": "comment.block.c.uefi-asl"
    }
  }
}
